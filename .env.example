VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional stable public site origin for OAuth redirect (recommended for production).
# Example production value: https://sovereign-shield-ai.vercel.app
# When unset, sign-in uses the current browser origin (localhost / preview deployments).
# VITE_SITE_URL=

# Supabase Auth (Google OAuth)
# 1. Enable Google provider in Supabase Dashboard → Authentication → Providers.
# 2. Add this app's origin to Authentication → URL Configuration → Redirect URLs, e.g.:
#    http://localhost:5173/
#    https://sovereign-shield-ai.vercel.app/**

# Edge Function secrets / config (NOT Vite — set via `supabase secrets set` / Dashboard):
# GEMINI_API_KEY=<server-side Google Gemini API key>
# COPILOT_ALLOWED_ORIGINS=https://your-production-domain
#   (http://localhost:5173 is always allowed in the Edge Function; never use *.)
